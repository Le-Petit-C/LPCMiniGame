{
	"schemaVersion": 1,
	"id": "lpcminigame",
	"version": "${version}",
	"name": "LPCMiniGame",
	"description": "Le_Petit_C's mini-game mod",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
